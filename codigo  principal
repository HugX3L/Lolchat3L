function makeAdminPanelDraggable(){
const panel=document.getElementById("adminPanel");
const handle=document.getElementById("adminPanelDragHandle");
if(!panel||!handle||handle.dataset.ready)return;
handle.dataset.ready="1";
let dragging=false,startX=0,startY=0,startLeft=0,startTop=0;
const start=(e)=>{
if(e.target.closest("button"))return;
const pt=e.touches?e.touches[0]:e;
const rect=panel.getBoundingClientRect();
if(!panel.style.left||panel.style.left==="50%")panel.style.left=rect.left+"px";
panel.style.top=rect.top+"px";
panel.style.transform="none";
startX=pt.clientX;startY=pt.clientY;startLeft=rect.left;startTop=rect.top;dragging=true;
};
const move=(e)=>{if(!dragging)return;const pt=e.touches?e.touches[0]:e;panel.style.left=Math.max(0,Math.min(window.innerWidth-panel.offsetWidth,startLeft+pt.clientX-startX))+"px";panel.style.top=Math.max(0,Math.min(window.innerHeight-60,startTop+pt.clientY-startY))+"px";e.preventDefault();};
const stop=()=>dragging=false;
handle.addEventListener("mousedown",start);document.addEventListener("mousemove",move);document.addEventListener("mouseup",stop);
handle.addEventListener("touchstart",start,{passive:false});document.addEventListener("touchmove",move,{passive:false});document.addEventListener("touchend",stop);
}

