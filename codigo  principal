function banUser(userId){
if(isOwner(userId)){
alert("No puedes banear al dueño del sitio.");
return;
}
if(isAdmin(userId)&&!isOwner(getMyId())){
alert("Solo el dueño del sitio puede banear a otro administrador.");
return;
}
const banned=getBanned();
if(!banned.includes(userId))banned.push(userId);
saveBanned(banned);
renderAdminUsersList();
}

function unbanUser(userId){
saveBanned(getBanned().filter(id=>id!==userId));
renderAdminUsersList();
}

function promoteToAdmin(userId){
if(!isOwner(getMyId())){
alert("Solo el dueño del sitio puede nombrar administradores.");
return;
}
const admins=getAdmins();
if(!admins.includes(userId))admins.push(userId);
saveAdmins(admins);
renderAdminUsersList();
}

function demoteAdmin(userId){
if(!isOwner(getMyId())){
alert("Solo el dueño del sitio puede quitar administradores.");
return;
}
saveAdmins(getAdmins().filter(id=>id!==userId));
renderAdminUsersList();
}

