function requestJoin(groupId){
const groups=getGroups();
const group=groups.find(g=>g.id===groupId);
if(!group)return;
const myId=getMyId();
if(group.members.includes(myId)||group.pending.includes(myId))return;
group.pending.push(myId);
saveGroups(groups);
renderGroupsList();
}

function acceptRequest(groupId,userId){
const groups=getGroups();
const group=groups.find(g=>g.id===groupId);
if(!group)return;
group.pending=group.pending.filter(id=>id!==userId);
if(!group.members.includes(userId))group.members.push(userId);
saveGroups(groups);
renderOwnerPanel(group);
}

function rejectRequest(groupId,userId){
const groups=getGroups();
const group=groups.find(g=>g.id===groupId);
if(!group)return;
group.pending=group.pending.filter(id=>id!==userId);
saveGroups(groups);
renderOwnerPanel(group);
}

