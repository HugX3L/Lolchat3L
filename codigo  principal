function collectKnownUsers(){
const users={};
function record(id,name){
if(!id)return;
if(!users[id]||name)users[id]={id:id,name:name||(users[id]?users[id].name:anonTag(id))};
}
getPosts().forEach(post=>{
record(post.authorId,post.authorName);
(post.replies||[]).forEach(reply=>record(reply.authorId,reply.authorName));
});
getGroupPosts().forEach(post=>record(post.authorId,post.authorName));
record(getMyId(),getMyDisplayName());
return Object.values(users);
}

