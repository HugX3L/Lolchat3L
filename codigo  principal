const posts=getGroupPosts().filter(post=>post.group===currentGroup&&post.age===selectedAge);

if(!posts.length){
container.innerHTML='<div class="thread">Todavía no hay publicaciones en este grupo.</div>';
return;
}

posts.forEach(post=>{
const thread=document.createElement("div");
thread.className="thread";
let mediaHTML="";
if(post.media){
if(post.media.type==="image"){
mediaHTML='<img class="media-image" src="'+post.media.data+'" alt="'+escapeHTML(post.media.name||"Imagen")+'">';
}else{
mediaHTML='<video class="media-video" controls src="'+post.media.data+'"></video>';
}
}

const authorName=post.authorName||anonTag(post.authorId);
const safeId=post.id||"";

thread.innerHTML=
'<div class="thread-header"><span class="author-name">'+escapeHTML(authorName)+(post.authorId===myId?' (tú)':'')+'</span> — '+escapeHTML(post.date)+' — '+escapeHTML(post.age)+'</div>'+
'<div class="thread-message" id="groupPostText-'+escapeHTML(safeId)+'">'+(post.text?escapeHTML(post.text):'')+'</div>'+
mediaHTML+
(amAdmin&&safeId?'<div class="msg-admin-actions"><button class="edit-msg-btn" onclick="startEditGroupPost(\''+safeId+'\')">Editar</button><button class="delete-msg-btn" onclick="deleteGroupPost(\''+safeId+'\')">Eliminar</button></div><div class="edit-msg-form" id="editGroupPostForm-'+escapeHTML(safeId)+'" style="display:none"></div>':'');

container.appendChild(thread);
});
}

function startEditGroupPost(postId){
if(!isAdmin(getMyId()))return;
const form=document.getElementById("editGroupPostForm-"+postId);
const posts=getGroupPosts();
const post=posts.find(p=>p.id===postId);
if(!post)return;
form.innerHTML='<textarea id="editGroupPostText-'+postId+'"></textarea><div class="form-actions"><button onclick="saveEditGroupPost(\''+postId+'\')">Guardar</button><button onclick="document.getElementById(\'editGroupPostForm-'+postId+'\').style.display=\'none\'">Cancelar</button></div>';
document.getElementById("editGroupPostText-"+postId).value=post.text||"";
form.style.display="block";
}

function saveEditGroupPost(postId){
if(!isAdmin(getMyId()))return;
const newText=document.getElementById("editGroupPostText-"+postId).value;
const posts=getGroupPosts();
const post=posts.find(p=>p.id===postId);
if(!post)return;
post.text=newText;
post.editedByAdmin=true;
localStorage.setItem("lolchat3l_group_posts",JSON.stringify(posts));
loadGroupPosts();
}

function deleteGroupPost(postId){
if(!isAdmin(getMyId()))return;
if(!confirm("¿Eliminar esta publicación?"))return;
const posts=getGroupPosts().filter(p=>p.id!==postId);
localStorage.setItem("lolchat3l_group_posts",JSON.stringify(posts));
loadGroupPosts();
}

function previewGroupMedia(){
const file=document.getElementById("groupMediaFile").files[0];
const preview=document.getElementById("groupMediaPreview");
document.getElementById("groupFileName").textContent=file?file.name:"Ningún archivo seleccionado";
preview.innerHTML="";
if(!file){preview.style.display="none";return;}

const url=URL.createObjectURL(file);
if(file.type.startsWith("image/")){
const img=document.createElement("img");
img.src=url;
preview.appendChild(img);
}else if(file.type.startsWith("video/")){
const video=document.createElement("video");
video.src=url;
video.controls=true;
preview.appendChild(video);
}
preview.style.display="block";
}

function escapeHTML(text){
const div=document.createElement("div");
div.textContent=String(text);
return div.innerHTML;
}
</script>
</body>
</html>
